# Build/dev stage
FROM node:24-alpine AS dev

WORKDIR /app

# Which app this image serves: "webapp" (default) or "adminpanel". Baked into
# the image as VITE_APP_TARGET, which `main.tsx` reads to pick the root
# component. The ENV flows into both `npm run build` below and the dev server
# launched by the ENTRYPOINT, so one Dockerfile parameterizes both modes.
ARG APP_TARGET=webapp
ENV VITE_APP_TARGET=$APP_TARGET

# Copy package dependencies and install
COPY package.json .
COPY package-lock.json .

RUN npm ci

# Copy config files
COPY tsconfig.json .
COPY tsconfig.node.json .
COPY tsconfig.app.json .
COPY vite.config.ts .
COPY eslint.config.js .
COPY .prettierrc* .
COPY .prettierignore* .

# Copy source files
COPY index.html .
COPY public/ public/
COPY src/ src/

# Check and build
RUN npm run prettier-check
RUN npm run lint-check
RUN npm run build

ENTRYPOINT ["npm", "run", "dev", "--"]

# Production stage
FROM nginx:alpine AS prod

COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /app
COPY --from=dev /app/dist /app

ENTRYPOINT ["nginx", "-g", "daemon off;"]
